# Docker: MongoDB and Ollama run on the host machine.
# For local development without Docker, replace host.docker.internal with localhost.
MONGODB_URI=mongodb://host.docker.internal:27017
MONGODB_DB_NAME=local_inference_api
LLM_URL=http://host.docker.internal:11434

# Required for user management: replace with your authentication service endpoint.
REFRESH_TOKEN_URL=http://your-auth-service:3000/api/auth/refresh
